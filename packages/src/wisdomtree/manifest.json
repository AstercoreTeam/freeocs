{
  "schema_version": 1,
  "api_version": 1,
  "id": "wisdomtree",
  "name": "智慧树",
  "version": "0.3.0",
  "type": "module",
  "description": "智慧树课程与测验网页自动化：浏览器扩展读取页面并通过 FreeOCS 模型作答。",
  "author": "FreeOCS",
  "license": "AGPL-3.0-only",
  "entry": "main:setup",
  "platform": "web",
  "requires": [
    "llm.chat",
    "web.bridge"
  ],
  "optional_requires": [],
  "provides": {},
  "dependencies": [],
  "min_app_version": "0.2.0",
  "web": {
    "allowed_hosts": [
      "zhihuishu.com",
      "*.zhihuishu.com"
    ]
  },
  "page_agents": [
    {
      "id": "wisdomtree",
      "matches": [
        "*://zhihuishu.com/*",
        "*://*.zhihuishu.com/*"
      ],
      "entry": "web/page-agent.js"
    }
  ],
  "panels": [
    {
      "id": "wisdomtree_console",
      "title": "智慧树状态",
      "entry": "web/panel.js",
      "styles": [
        "web/panel.css"
      ],
      "order": 100
    }
  ],
  "settings": [
    {
      "id": "wisdomtree",
      "title": "智慧树",
      "order": 310,
      "fields": [
        {
          "key": "auto_submit",
          "type": "boolean",
          "label": "自动提交作业",
          "default": false,
          "help": "默认关闭：答完后停在提交页等待人工核对。开启后会自动点击提交及确认按钮。"
        },
        {
          "key": "mastery_threshold",
          "type": "integer",
          "label": "章节掌握度目标（%）",
          "default": 85,
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "key": "click_interval_ms",
          "type": "integer",
          "label": "点击间隔（毫秒）",
          "default": 1500,
          "min": 200,
          "max": 10000,
          "step": 100
        },
        {
          "key": "click_jitter_ms",
          "type": "integer",
          "label": "点击间隔随机误差（毫秒）",
          "default": 500,
          "min": 0,
          "max": 5000,
          "step": 100
        },
        {
          "key": "max_questions_per_exam",
          "type": "integer",
          "label": "每套题最大题数",
          "default": 80,
          "min": 1,
          "max": 200,
          "step": 1
        },
        {
          "key": "max_chapters_per_run",
          "type": "integer",
          "label": "每次最多处理章节数",
          "default": 100,
          "min": 1,
          "max": 500,
          "step": 1
        },
        {
          "key": "max_answers_per_chapter",
          "type": "integer",
          "label": "每章节最多重做次数",
          "default": 3,
          "min": 1,
          "max": 10,
          "step": 1
        },
        {
          "key": "max_no_test_attempts",
          "type": "integer",
          "label": "无试题章节最大尝试次数",
          "default": 2,
          "min": 1,
          "max": 10,
          "step": 1
        },
        {
          "key": "max_open_fail_attempts",
          "type": "integer",
          "label": "无法打开章节最大尝试次数",
          "default": 2,
          "min": 1,
          "max": 10,
          "step": 1
        },
        {
          "key": "empty_pending_retries",
          "type": "integer",
          "label": "无待处理章节时复查次数",
          "default": 3,
          "min": 0,
          "max": 10,
          "step": 1
        },
        {
          "key": "empty_pending_retry_ms",
          "type": "integer",
          "label": "章节复查间隔（毫秒）",
          "default": 3000,
          "min": 1000,
          "max": 10000,
          "step": 500
        },
        {
          "key": "answer_timeout",
          "type": "number",
          "label": "模型答题超时（秒）",
          "default": 120,
          "min": 10,
          "max": 600,
          "step": 10
        },
        {
          "key": "answer_temperature",
          "type": "number",
          "label": "模型温度",
          "default": 0.2,
          "min": 0,
          "max": 1,
          "step": 0.1
        },
        {
          "key": "allow_short_answer",
          "type": "boolean",
          "label": "允许处理主观题/简答题",
          "default": true
        }
      ]
    }
  ]
}
