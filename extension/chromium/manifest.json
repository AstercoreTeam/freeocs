{
  "manifest_version": 3,
  "name": "FreeOCS Browser Bridge",
  "version": "0.1.2",
  "description": "FreeOCS 本地学习助手的浏览器中继（仅连接 127.0.0.1）。",
  "minimum_chrome_version": "109",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FreeOCS Bridge"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
